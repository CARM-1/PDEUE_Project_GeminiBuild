{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IF-015_DecisionPacket",
  "type": "object",
  "properties": {
    "packet_id": { "type": "string" },
    "event_id": { "type": "string" },
    "operating_mode": { "type": "string", "enum": ["NORMAL", "DEGRADED", "BLOCKED", "KILL_SWITCH"] },
