{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IF-015_DecisionPacket",
  "type": "object",
  "properties": {
    "packet_id": { "type": "string", "format": "uuid" },
    "event_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "operating_mode": { 
      "type": "string", 
      "enum": ["NORMAL", "DEGRADED", "BLOCKED", "KILL_SWITCH"] 
    },
    "blocked_reasons": { 
      "type": "array", 
      "items": { "type": "string" } 
    }
  },
  "required": ["packet_id", "event_id", "timestamp", "operating_mode", "blocked_reasons"]
}
