{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IF-039_StabilityAdvanceFacilityRegistered",
  "type": "object",
  "properties": {
    "@context": { "type": "string", "const": "https://schema.pdeue.org/accounting/v1" },
    "event_type": { "type": "string", "const": "STABILITY_ADVANCE_FACILITY_REGISTERED" },
    "facility_id": { "type": "string", "pattern": "^FSAP-ADV-[0-9]{4}-[0-9]{4}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "recipient_scma_id": { "type": "string" },
    "household_id": { "type": "string" },
    "total_advance_cents": { "type": "integer", "minimum": 1 },
    "disbursement_plan": {
      "type": "object",
      "properties": {
        "direct_creditor_payments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "creditor_name": { "type": "string" },
              "reference_id": { "type": "string" },
              "amount_cents": { "type": "integer", "minimum": 1 },
              "disbursement_method": { "type": "string", "enum": ["CORPORATE_ACH", "WIRE", "CHECK"] }
            },
            "required": ["creditor_name", "reference_id", "amount_cents", "disbursement_method"]
          }
        },
        "initial_scma_seed_cents": { "type": "integer", "minimum": 0 }
      },
      "required": ["direct_creditor_payments", "initial_scma_seed_cents"]
    },
    "amortization_terms": {
      "type": "object",
      "properties": {
        "interception_percentage": { "type": "number", "minimum": 0.30, "maximum": 0.70, "default": 0.50 },
        "f2_discretionary_bounds": {
          "type": "object",
          "properties": {
            "min_percentage": { "type": "number", "const": 0.30 },
            "max_percentage": { "type": "number", "const": 0.70 },
            "adjustment_lock_days": { "type": "integer", "const": 30 }
          },
          "required": ["min_percentage", "max_percentage", "adjustment_lock_days"]
        },
        "recovery_target_cents": { "type": "integer", "minimum": 1 },
        "voluntary_pay_forward_eligible": { "type": "boolean" }
      },
      "required": ["interception_percentage", "f2_discretionary_bounds", "recovery_target_cents", "voluntary_pay_forward_eligible"]
    },
    "governance_signatures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string", "enum": ["F2_HEAD_OF_HOUSEHOLD", "CHIEF_ADMINISTRATOR"] },
          "actor_id": { "type": "string" },
          "signed_at": { "type": "string", "format": "date-time" },
          "signature_hmac_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
        },
        "required": ["role", "actor_id", "signed_at", "signature_hmac_sha256"]
      }
    }
  },
  "required": ["@context", "event_type", "facility_id", "timestamp", "recipient_scma_id", "household_id", "total_advance_cents", "disbursement_plan", "amortization_terms", "governance_signatures"]
}
